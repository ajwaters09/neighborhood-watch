<diagram id="page3" name="Agent"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="760" math="0" shadow="0" background="#fcfcfb"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;One chat turn&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#55534e&#x27; style=&quot;font-size:12px&quot;&gt;A plain tool-calling loop: the model picks tools, plain Python functions run them, the loop repeats until it answers.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#1b1b1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1300" height="50" as="geometry"/></mxCell><mxCell id="lane4" value="TOOLS  ·  src/agent_tools.py, each wrapped in @_logged" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f4fbf8;strokeColor=#1b9e6f;strokeOpacity=35;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontStyle=1;fontSize=11;fontColor=#11704d;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="1260" height="330" as="geometry"/></mxCell><mxCell id="user" value="&lt;b&gt;Resident&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;chat panel, any view&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#55534e;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="170" height="70" as="geometry"/></mxCell><mxCell id="route" value="&lt;b&gt;POST /chat&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;webapp/main.py&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5ee;strokeColor=#1b9e6f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="260" y="110" width="210" height="70" as="geometry"/></mxCell><mxCell id="loop" value="&lt;b&gt;run_chat&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;src/agent_chat.py&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;system prompt + metric names&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;+ user id + the area in view&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;≤ 4 model rounds&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e3f5ee;strokeColor=#1b9e6f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="300" height="110" as="geometry"/></mxCell><mxCell id="fm" value="&lt;b&gt;Foundation Model API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;Claude Sonnet&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;OpenAI chat-completions protocol&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="105" width="230" height="80" as="geometry"/></mxCell><mxCell id="t0" value="&lt;b&gt;get_area_trend&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;Lakebase Synced Tables&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="225" height="56" as="geometry"/></mxCell><mxCell id="t1" value="&lt;b&gt;get_recent_activity&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;silver tables, via SQL&lt;/font&