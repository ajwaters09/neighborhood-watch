<diagram id="page1" name="Nightly job"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1540" pageHeight="600" math="0" shadow="0" background="#fcfcfb"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;The nightly pipeline&lt;/b&gt;&lt;br&gt;&lt;font color=&#x27;#55534e&#x27; style=&quot;font-size:12px&quot;&gt;One Lakeflow Job on serverless compute. Each notebook starts once everything it reads is fresh.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontColor=#1b1b1a;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1500" height="50" as="geometry"/></mxCell><mxCell id="n02d" value="&lt;b&gt;02d · Wikipedia&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;changed revisions only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="210" height="56" as="geometry"/></mxCell><mxCell id="n02b" value="&lt;b&gt;02b · Weather&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;Open-Meteo observed + forecast&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="210" height="56" as="geometry"/></mxCell><mxCell id="n02" value="&lt;b&gt;02 · Crime + 311&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;SODA, watermarked appends&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="210" height="56" as="geometry"/></mxCell><mxCell id="n02c" value="&lt;b&gt;02c · Events&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;permits · setlist.fm · Ticketmaster&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="210" height="56" as="geometry"/></mxCell><mxCell id="n03c" value="&lt;b&gt;03c · Wiki passages&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;chunks + vector index sync&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#7d8b9b;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="290" y="90" width="210" height="56" as="geometry"/></mxCell><mxCell id="n03" value="&lt;b&gt;03 · Silver&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;type · clean · deduplicate&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eef2f6;strokeColor=#7d8b9b;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="290" y="270" width="210" height="56" as="geometry"/></mxCell><mxCell id="n08" value="&lt;b&gt;08 · Next-week outlook&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;backtest + live forecast&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fcf4d8;strokeColor=#c29a22;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="210" height="56" as="geometry"/></mxCell><mxCell id="n03b" value="&lt;b&gt;03b · Crime categories&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;