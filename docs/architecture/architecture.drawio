ry"/></mxCell><mxCell id="t6" value="&lt;b&gt;get_upcoming_events&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;events_upcoming&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="550" y="390" width="225" height="56" as="geometry"/></mxCell><mxCell id="t7" value="&lt;b&gt;search_area_background&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;Vector Search, hybrid&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e6f0fc;strokeColor=#2a78d6;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="795" y="390" width="225" height="56" as="geometry"/></mxCell><mxCell id="w0" value="&lt;b&gt;subscribe_to_area&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;write · area_subscriptions&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="225" height="56" as="geometry"/></mxCell><mxCell id="w1" value="&lt;b&gt;log_resident_report&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;write · resident_reports&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fbefe3;strokeColor=#c4813f;strokeWidth=1.5;fontSize=13;fontColor=#1b1b1a;fontFamily=Helvetica;dashed=0;" vertex="1" parent="1"><mxGeometry x="305" y="470" width="225" height="56" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;Every call&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27; color=&#x27;#55534e&#x27;&gt;logged to tool_invocations&lt;/font&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11